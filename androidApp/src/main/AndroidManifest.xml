<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Recherche des coordonnées d'un site par son nom (OpenStreetMap). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Savoir si le réseau fonctionne : la carte s'ouvre en vue satellite avec du réseau, en plan sans. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Sub Atlas"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubAtlas">
        <!-- Clé de l'API Google Maps (SDK Maps pour Android), lue dans local.properties : voir androidApp/build.gradle.kts. -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />
        <!-- Le module Maps de Google Play services utilise l'ancienne bibliothèque HTTP Apache, absente par défaut
             depuis Android 9 : sans cette déclaration, la carte plante (NoClassDefFoundError org.apache.http.ProtocolVersion). -->
        <uses-library android:name="org.apache.http.legacy" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.SubAtlas.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Plongée partagée par un binôme : subatlas://dive?d=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="subatlas" android:host="dive" />
            </intent-filter>
            <!-- Fichier partagé depuis une autre appli (export Shearwater .db) : « Partager > SubAtlas » -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <!-- ... ou « Ouvrir avec » depuis un gestionnaire de fichiers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- Partage d'un fichier de plongée : le fichier temporaire du cache est exposé le temps de l'envoi -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
